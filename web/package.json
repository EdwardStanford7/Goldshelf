{
  "name": "goldshelf-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "vite dev",
    "build": "tsr generate && vite build",
    "preview": "vite preview",
    "check": "pnpm test && pnpm typecheck && pnpm test:e2e:smoke && node scripts/audit-prod.mjs && pnpm build",
    "deploy": "pnpm run check && pnpm db:migrate:remote && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply media-rating --local",
    "db:migrate:remote": "wrangler d1 migrations apply media-rating --remote",
    "test": "vitest run --config vitest.config.ts",
    "test:dev": "wrangler d1 migrations apply media-rating --local --config wrangler.e2e.jsonc --persist-to .wrangler/e2e-state && vite dev --config vite.config.e2e.ts",
    "test:e2e": "pnpm run test:e2e:full",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:full": "playwright test",
    "typecheck": "tsr generate && tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "read-excel-file": "^9.0.10",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "write-excel-file": "^4.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261027.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-cli": "^1.167.13",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "shadcn": "^4.10.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.153.0"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "^2.3.0",
      "brace-expansion": "^5.0.9",
      "esbuild": "^0.28.1",
      "fast-uri": "^3.1.4",
      "hono": "^4.12.27",
      "js-yaml": "^4.3.1",
      "kysely": "^0.28.17",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.18",
      "source-map-js": "^1.2.2"
    }
  }
}
